// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UniversalRecord {
  id               String   @id @default(cuid())
  merchantId       String

  entityType       String
  source           String
  sourceRecordId   String

  title            String?
  status           String?

  amount           Float?
  currency         String?

  timestamp        DateTime?
  metadata         Json
  rawPayload       Json

  createdAt        DateTime @default(now())

  @@unique([source, sourceRecordId, merchantId])
  @@index([merchantId])
  @@index([merchantId, source])
  @@index([merchantId, entityType])
  @@index([merchantId, timestamp])
}

model AgentRun {
  id              String    @id @default(cuid())
  merchantId      String
  agentName       String
  triggeredAt     DateTime  @default(now())
  completedAt     DateTime?
  status          String    @default("running")
  rowsExamined    Int       @default(0)
  proposedActions Json?
  reasoning       String?
  steps           Json?
  error           String?

  @@index([merchantId])
}

model IngestRun {
  id           Int       @id @default(autoincrement())
  merchantId   String
  source       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  rowsUpserted Int       @default(0)
  error        String?
}
